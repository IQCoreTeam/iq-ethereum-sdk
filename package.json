{
  "name": "@iqlabs-official/ethereum-sdk",
  "version": "0.2.2",
  "description": "IQLabs Ethereum SDK",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm-extensions.cjs && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2))\"",
    "build": "npm run build:cjs && npm run build:esm",
    "prepare": "npm run build",
    "test": "tsx test/smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IQCoreTeam/iq-ethereum-sdk.git"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "dotenv": "^17.4.1",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
